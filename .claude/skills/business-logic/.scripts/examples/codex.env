# ============================================================
# Preset: Codex subscription  (NO API key needed)
# ------------------------------------------------------------
# You pay for Codex (ChatGPT); the sync runs on that subscription via
# `codex exec`, so it costs no extra API tokens. No provider credentials here.
# Install: cp this to .agents/.env (or .claude/.env).
# ============================================================

# --- Run sync on the Codex subscription itself ---
SYNC_RUNNER=codex

# --- Codex model + reasoning effort ---
# A ChatGPT subscription rejects some names (e.g. gpt-5.3); gpt-5.6-luna works
# and is ~5x faster than the default. low reasoning keeps syncs quick.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING=low

# --- Digest Codex's conversation logs ---
TRANSCRIPT_SOURCE=codex

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0

# NOTE: SYNC_BACKEND / OPENAI_* / ANTHROPIC_* are unused when SYNC_RUNNER=codex.
