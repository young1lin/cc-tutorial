# ============================================================
# Preset: OpenRouter  +  Claude Code transcripts
# ------------------------------------------------------------
# You code with Claude Code; the sync calls any model via OpenRouter.
# Install: cp this to .claude/.env  (or .agents/.env), then fill the key.
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=openai

# --- OpenRouter (OpenAI-compatible; model is provider/name) ---
# Swap the model for any OpenRouter-supported one, e.g.:
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash
#   meta-llama/llama-3.3-70b-instruct
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-key
OPENAI_MODEL=anthropic/claude-3.5-sonnet

# --- Digest Claude Code's conversation logs ---
TRANSCRIPT_SOURCE=claude-code

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
