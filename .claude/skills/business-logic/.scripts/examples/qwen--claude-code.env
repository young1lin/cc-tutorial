# ============================================================
# Preset: Tongyi Qianwen (DashScope)  +  Claude Code transcripts
# ------------------------------------------------------------
# You code with Claude Code; the sync calls Alibaba's DashScope API directly.
# Install: cp this to .claude/.env  (or .agents/.env), then fill the key.
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=openai

# --- Tongyi Qianwen / DashScope (OpenAI-compatible mode) ---
# Models: qwen-plus (balanced), qwen-max (strongest), qwen-turbo (cheapest).
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-dashscope-key
OPENAI_MODEL=qwen-plus

# --- Digest Claude Code's conversation logs ---
TRANSCRIPT_SOURCE=claude-code

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
