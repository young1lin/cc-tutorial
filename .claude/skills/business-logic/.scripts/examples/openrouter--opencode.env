# ============================================================
# Preset: OpenRouter  +  opencode transcripts
# ------------------------------------------------------------
# You code with opencode; the sync calls any model via OpenRouter.
# Install: cp this to .agents/.env, then fill the key.
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=openai

# --- OpenRouter (OpenAI-compatible; model is provider/name) ---
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-key
OPENAI_MODEL=anthropic/claude-3.5-sonnet

# --- Proxy (uncomment if reaching OpenRouter from behind a regional proxy) ---
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- Digest opencode's conversation logs ---
TRANSCRIPT_SOURCE=opencode

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
