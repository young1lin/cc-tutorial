# ============================================================
# Preset: Anthropic API (direct)  +  Claude Code transcripts
# ------------------------------------------------------------
# You code with Claude Code; the sync calls the Anthropic API directly.
# Anthropic is overseas -- set the proxy lines if you are behind one.
# Install: cp this to .claude/.env, fill the key (+ proxy if needed).
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=anthropic

# --- Anthropic (Messages API) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Proxy (uncomment if reaching Anthropic from behind a regional proxy) ---
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- Digest Claude Code's conversation logs ---
TRANSCRIPT_SOURCE=claude-code

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
