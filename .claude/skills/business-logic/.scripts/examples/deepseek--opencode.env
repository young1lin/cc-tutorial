# ============================================================
# Preset: DeepSeek  +  opencode transcripts
# ------------------------------------------------------------
# You code with opencode; the sync calls DeepSeek's API directly.
# Install: cp this to .agents/.env, then fill the key.
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=openai

# --- DeepSeek (OpenAI-compatible) ---
# deepseek-v4-flash = fast, cheap, supports reasoning_effort.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-deepseek-key
OPENAI_MODEL=deepseek-v4-flash
REASONING_EFFORT=high

# --- Digest opencode's conversation logs ---
TRANSCRIPT_SOURCE=opencode

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
