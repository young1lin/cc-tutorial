# ============================================================
# Preset: Claude Code subscription  (NO API key needed)
# ------------------------------------------------------------
# You already pay for Claude Code; the sync runs on that subscription via
# `claude -p`, so it costs no extra API tokens. No provider credentials here.
# Install: cp this to .claude/.env.
# ============================================================

# --- Run sync on the Claude Code subscription itself ---
SYNC_RUNNER=claude

# --- Digest Claude Code's conversation logs ---
TRANSCRIPT_SOURCE=claude-code

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0

# NOTE: SYNC_BACKEND / OPENAI_* / ANTHROPIC_* are unused when SYNC_RUNNER=claude.
# The CLI's own auth drives the sync.
