# ============================================================
# Preset: opencode native  (uses opencode's configured provider)
# ------------------------------------------------------------
# You run opencode; the sync runs via `opencode run`, reusing whatever
# provider opencode is already configured with (e.g. GLM Coding Plan).
# The API key lives in opencode's own config, NOT here -- so this file needs
# no credentials. Install: cp this to .agents/.env (or .opencode/.env).
# ============================================================

# --- Run sync on opencode itself (reuses its provider + key) ---
SYNC_RUNNER=opencode

# --- Pin a model + reasoning effort (overrides opencode's default) ---
OPENCODE_MODEL=zhipuai-coding-plan/glm-5.2
OPENCODE_VARIANT=low

# --- Digest opencode's conversation logs ---
TRANSCRIPT_SOURCE=opencode

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0

# NOTE: SYNC_BACKEND / OPENAI_* are unused when SYNC_RUNNER=opencode.
# To instead call a provider API directly, set SYNC_RUNNER=api and copy the
# matching OPENAI_* block from another preset in this folder.
