# ============================================================
# Preset: Zhipu GLM Coding Plan  +  opencode transcripts
# ------------------------------------------------------------
# You code with opencode; the sync calls Zhipu's GLM API directly.
# Install: cp this to .agents/.env, then fill the key.
# ============================================================

# --- Who runs the sync (call the provider API directly) ---
SYNC_RUNNER=api
SYNC_BACKEND=openai

# --- Zhipu GLM Coding Plan (OpenAI-compatible) ---
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_API_KEY=your-zhipu-key
OPENAI_MODEL=glm-5.2
REASONING_EFFORT=low

# --- Digest opencode's conversation logs ---
TRANSCRIPT_SOURCE=opencode

# --- Tuning (safe defaults) ---
API_TIMEOUT_MS=1800000
SYNC_MAX_TOKENS=8192
ALLOW_SYNC_BASH=0
