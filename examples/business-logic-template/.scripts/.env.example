# ============================================================
# business-logic auto-sync environment
# Copy to <cli>/.env (.claude/.env, .agents/.env, ...) and fill in. Git-ignored.
#
# Want a ready-made config? Copy a PRESET from examples/ instead -- only the
# API key is left blank:
#   examples/claude-code-subscription.env Claude Code subscription (no API key)
#   examples/codex.env                   Codex subscription      (no API key)
#   examples/opencode-native.env         opencode native         (no API key here)
#   examples/zhipu--claude-code.env       Zhipu GLM Coding Plan + Claude Code
#   examples/deepseek--claude-code.env    DeepSeek             + Claude Code
#   examples/openrouter--claude-code.env  OpenRouter           + Claude Code
#   examples/anthropic--claude-code.env   Anthropic API        + Claude Code
#   examples/qwen--claude-code.env        Tongyi Qianwen       + Claude Code
#   examples/zhipu--opencode.env          Zhipu GLM Coding Plan + opencode
#   examples/deepseek--opencode.env       DeepSeek             + opencode
#   examples/qwen--opencode.env           Tongyi Qianwen       + opencode
#   examples/openrouter--opencode.env     OpenRouter           + opencode
#   examples/anthropic--opencode.env      Anthropic API        + opencode
# ============================================================

# --- Sync runner (WHO executes the sync) ---
# auto (default) : prefer an installed CLI headless -- it runs on your existing
#                  Claude Code / Codex subscription or opencode provider, so it
#                  costs no extra API tokens. Falls back to `api` if none present.
# claude         : force `claude -p` (Claude Code subscription, or whatever it's configured to use)
# codex          : force `codex exec` (Codex subscription; pin a low-tier model below)
# opencode       : force `opencode run` (opencode's configured provider, e.g. GLM Coding Plan)
# api            : skip the CLI and call the model API directly (the SYNC_BACKEND below)
SYNC_RUNNER=auto

# codex model + reasoning effort. A Codex ChatGPT subscription rejects some
# names (e.g. gpt-5.3); gpt-5.6-luna works and is ~5x faster than the default
# (~70s vs ~6min for a sync). CODEX_REASONING (low/medium/high) is always honored.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING=low

# opencode model override (provider/model format). Pin a model instead of
# accepting opencode's default (which may be a *-highspeed variant).
# Example: zhipuai-coding-plan/glm-5.2
OPENCODE_MODEL=zhipuai-coding-plan/glm-5.2

# opencode reasoning effort (low is faster/cheaper; high/max think more).
OPENCODE_VARIANT=low

# --- API backend (used only when SYNC_RUNNER=api, or auto finds no CLI) ---
# openai     : OpenAI ChatCompletion -- and any compatible endpoint
#              (glm / deepseek / qwen / one-api / new-api relays all go here)
# anthropic  : Anthropic Messages
# claude-sdk : legacy, uses claude-agent-sdk (needs it installed separately)
SYNC_BACKEND=openai

# --- OpenAI-compatible provider ---
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_API_KEY=your-key
OPENAI_MODEL=glm-5.2
# Reasoning effort (thinking level) for providers that support the OpenAI
# reasoning_effort param: low / medium / high / max. Honored by DeepSeek V4,
# GLM, etc. Anthropic ignores this (uses a different thinking budget).
REASONING_EFFORT=low

# --- Anthropic provider ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your-key
# ANTHROPIC_AUTH_TOKEN is also accepted (back-compat with claude-agent-sdk).
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Proxy (httpx reads these env vars automatically; leave commented to skip) ---
# Use these when reaching overseas endpoints from behind a corporate/regional
# proxy. No code change needed -- PydanticAI/httpx honors them at runtime.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,open.bigmodel.cn   # domestic endpoints bypass proxy

# --- Tuning ---
API_TIMEOUT_MS=1800000      # per-turn timeout (ms); a sync can be slow
SYNC_MAX_TOKENS=8192        # max tokens per model reply
ALLOW_SYNC_BASH=0           # 1 enables the bash tool (disabled by default)

# --- Transcript source (which CLI's conversations to digest into docs) ---
# auto | claude-code | codex | opencode | all
TRANSCRIPT_SOURCE=auto

# --- Legacy: claude-agent-sdk only (SYNC_BACKEND=claude-sdk) ---
CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
ANTHROPIC_DEFAULT_SONNET_MODEL=your-main-model
ANTHROPIC_SMALL_FAST_MODEL=your-fast-model
ANTHROPIC_DEFAULT_OPUS_MODEL=your-main-model
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-fast-model
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
