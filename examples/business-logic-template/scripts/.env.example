# Claude Code environment for the auto-sync git hooks.
# Copy this file to .env and fill in your own values. The .env file is git-ignored.

# Windows only: absolute path to git-bash (required by Claude Code on Windows).
# Linux/macOS: delete this line or leave it unset.
CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# API endpoint and key for your Claude-compatible provider.
ANTHROPIC_BASE_URL=https://api.your-provider.example.com
ANTHROPIC_AUTH_TOKEN=<your-api-key>

# Per-run timeout in milliseconds. Keep generous -- a sync can take many minutes.
API_TIMEOUT_MS=3000000

# Model ids exposed by your provider. Replace with real model names.
ANTHROPIC_MODEL=your-main-model
ANTHROPIC_SMALL_FAST_MODEL=your-fast-model
ANTHROPIC_DEFAULT_SONNET_MODEL=your-main-model
ANTHROPIC_DEFAULT_OPUS_MODEL=your-main-model
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-fast-model

# Reduces non-essential network traffic during automated runs.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --- Anti-corruption gate thresholds (all optional; defaults shown) ---
# Oversized docs are split in place during the sync round.
BL_MAX_DOC_BYTES=51200
# CHANGELOG is pruned to the newest N entries each sync.
BL_MAX_CHANGELOG_ENTRIES=20
# Comma-separated extra secret patterns appended to the built-in list.
BL_SECRET_SCAN_EXTRA=
# 1 = hard violations (secrets, merge-conflict markers) abort the sync round.
BL_AUDIT_FAIL_SYNC=1

# overview anchor older than N commits behind HEAD -> reconcile candidate.
BL_RECONCILE_STALE_COMMITS=50
